// Cloudflare 배포 설정: 이 폴더의 index.html 을 정적 사이트로 올립니다.
// (올리지 않을 파일은 .assetsignore 에 적혀 있습니다)
{
  "name": "bamnat-delivery",
  "compatibility_date": "2025-09-01",
  "main": "worker/keepalive.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  // Supabase 자동 깨우기: 2일마다 한국시간 낮 12시 (UTC 03:00)
  "triggers": {
    "crons": ["0 3 */2 * *"]
  },
  // index.html 에도 들어 있는 공개용 주소/키 (비밀값 아님)
  // SOLAPI_*: 정산서 알림톡 발송용 (공개돼도 되는 값). API 키/시크릿은 Cloudflare 대시보드의 "비밀(Secret)"로만 넣습니다.
  //   SOLAPI_SENDER: 솔라피에 등록한 발신번호 (카톡 실패 시 문자 대체발송에 사용)
  "vars": {
    "SUPABASE_URL": "https://doierphwtctcomrujgem.supabase.co",
    "SUPABASE_KEY": "sb_publishable_5XM4HoFx4U_0kL-8ET_x-Q_WfvGwFXL",
    "SOLAPI_PF_ID": "KA01PF261019090815900A7vHcGav3ie",
    "SOLAPI_TEMPLATE_ID": "KA01TP261019094837602auq34OnVvQw",
    "SOLAPI_SENDER": "01054259060"
  },
  // 브랜치 미리보기 사이트(Cloudflare Worker Previews)용 설정.
  // 이 값은 Supabase 자동 깨우기(예약 실행)에만 쓰이고, 미리보기에서는 예약 실행이 돌지 않습니다.
  // 화면이 쓰는 DB 는 config.js 가 정합니다 (미리보기 주소에서는 '테스트 사이트' 띠 표시).
  "previews": {
    "vars": {
      "SUPABASE_URL": "https://doierphwtctcomrujgem.supabase.co",
      "SUPABASE_KEY": "sb_publishable_5XM4HoFx4U_0kL-8ET_x-Q_WfvGwFXL",
      "SOLAPI_PF_ID": "KA01PF261019090815900A7vHcGav3ie",
      "SOLAPI_TEMPLATE_ID": "KA01TP261019094837602auq34OnVvQw",
      "SOLAPI_SENDER": "01054259060"
    }
  }
}
